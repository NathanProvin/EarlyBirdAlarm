rules_version = '2';
// Deploy from app/:  firebase deploy --only firestore:rules --project earlybird-alarm
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // A player reads and writes only their own document (the collection backup, Phase 1.1).
    match /players/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      // Its cards, in chunks of 1,000 (a document stops at 1 MB).
      match /cards/{chunk} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Codes we hand out (id = the word in lower case), {reward, active, end?}: made in the
    // console only.
    match /codes/{code} {
      allow read: if signedIn();
    }

    // One per account and code ({uid}_{code}): create-only, so a code works once per account.
    // Never deleted, else a player could redeem again.
    match /redemptions/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'code'])
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.code
        && exists(/databases/$(database)/documents/codes/$(request.resource.data.code))
        && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.active == true
        && request.time < get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.get('end', timestamp.value(4102444800000));
    }

    // Who invited whom (2026-11-12): written by the friend at first launch, read by the
    // inviter to count friends. The friend can delete it (account deletion).
    match /referrals/{friendUid} {
      allow read: if signedIn()
        && (request.auth.uid == friendUid || resource.data.inviterUid == request.auth.uid);
      allow create: if signedIn() && request.auth.uid == friendUid
        && request.resource.data.keys().hasOnly(['inviterUid'])
        && request.resource.data.inviterUid is string
        && request.resource.data.inviterUid != friendUid;
      allow delete: if signedIn() && request.auth.uid == friendUid;
    }

    // Profile page (2026-11-13). A unique @name: one document per name in lower case,
    // {uid}; taken if it exists. A rename creates the new one and deletes the old one.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // What other players see: the @name (one the owner holds), the avatar, the hall of
    // fame. Catalog content plus the chosen name only.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'hall'])
        && request.resource.data.name is string
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.name.lower())).data.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // A friend request, {to}_{from}: sent by `from`, seen and removed by either player.
    match /friendRequests/{id} {
      allow read, delete: if signedIn()
        && request.auth.uid in [resource.data.from, resource.data.to];
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.resource.data.to + '_' + request.auth.uid;
    }

    // Friends: an entry on each side, written together by the player who accepts, while
    // the request still exists; either friend can remove both.
    match /friends/{uid}/list/{other} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.resource.data.keys().size() == 0 && (
        (request.auth.uid == uid
          && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + other)))
        || (request.auth.uid == other
          && exists(/databases/$(database)/documents/friendRequests/$(other + '_' + uid))));
      allow delete: if signedIn() && request.auth.uid in [uid, other];
    }
    // Everything else stays closed.
  }
}
